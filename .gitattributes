# Normalize line endings in the repository
* text=auto

# Shell scripts must keep LF endings to run on Linux/macOS (e.g. ./mvnw)
mvnw text eol=lf
*.sh text eol=lf

# Windows scripts keep CRLF endings
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
