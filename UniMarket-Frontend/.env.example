# UniMarket frontend - example environment configuration
# Copy to UniMarket-Frontend/.env.local if you need to override defaults (git-ignored).
# Never put secrets in VITE_* variables: they are embedded in the browser bundle.

# Backend URL used by the Vite dev proxy for /api requests.
VITE_BACKEND_URL=http://localhost:8080

# Sample (mock) product data. Default: true for `npm run dev`, false for `npm run build`.
# Set to false in .env.local to test the real product API in development.
# VITE_USE_MOCK_DATA=true
