# UniMarket frontend - example environment configuration
# Copy to UniMarket-Frontend/.env.local to override defaults (.env.local is git-ignored).
# Never put secrets in VITE_* variables: they are embedded in the browser bundle.

# Backend URL used by the Vite dev / preview proxy for /api requests (the browser itself calls /api on the
# frontend origin, so no CORS is needed). For Stage 6 integration testing, point it at the ISOLATED test backend
# (port 8081, database UniMarketJava_V003Test). Do not run registration tests against the backend that uses the
# real UniMarketJava database.
VITE_BACKEND_URL=http://localhost:8080

# Optional: API base URL as seen by the browser. Default /api (through the proxy above). Use an absolute URL only
# if the backend allows this origin in CORS_ALLOWED_ORIGINS.
# VITE_API_BASE_URL=/api

# Authentication: 'backend' = real register / email code / login / profile through the API;
# 'demo' = preview only (a sample student is shown as signed in, nothing is sent).
# Default: demo while sample data is on (plain `npm run dev`), backend otherwise.
# VITE_AUTH_MODE=backend

# Sample (mock) product / order data. Default: true for `npm run dev`, false for `npm run build`.
# Products, cart, orders and admin pages still use sample data in Stage 6.1.
# VITE_USE_MOCK_DATA=true

# Products, categories, listings and saved items (Stage 6.2). Default: real API when VITE_AUTH_MODE=backend, otherwise
# it follows VITE_USE_MOCK_DATA. Cart, checkout, orders, profiles/reviews and admin pages still use sample data.
# VITE_USE_MOCK_PRODUCTS=false
