# ---------------------------------------------------------------------
# UniMarket backend - example environment configuration
# Copy this file to UniMarket-Backend/.env and fill in your own values:
#   Copy-Item .env.example .env
# UniMarket-Backend/.env is git-ignored. NEVER commit real credentials.
# Real environment variables take precedence over this file.
# ---------------------------------------------------------------------

# JDBC URL of the UniMarketJava database (created by UniMarket_BusinessAligned.sql).
# trustServerCertificate=true is for LOCAL development only.
# Default instance on port 1433:
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=UniMarketJava;encrypt=true;trustServerCertificate=true
# Named instance (needs the SQL Server Browser service), e.g.:
# DB_URL=jdbc:sqlserver://localhost;instanceName=SQLEXPRESS;databaseName=UniMarketJava;encrypt=true;trustServerCertificate=true

# SQL Server login (SQL Server Authentication must be enabled on the instance).
# Use a dedicated login with only the permissions the API needs, not 'sa'.
DB_USERNAME=your_sql_username
DB_PASSWORD=your_sql_password

# Optional overrides
# SERVER_PORT=8080
# DB_POOL_SIZE=10
# SPRING_PROFILES_ACTIVE=dev     # or 'nodb' to start without a database

# ---------------------------------------------------------------------
# Security (Backend Stage 2). Generate your own values, never commit them:
#   PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Maximum 256 }) -as [byte[]])
#   or:         openssl rand -base64 48
# With the 'dev' profile, missing values are replaced by random keys at startup
# (sign-ins and codes then stop working after each restart).
# ---------------------------------------------------------------------
JWT_SECRET=replace_with_base64_of_at_least_32_random_bytes
VERIFICATION_CODE_SECRET=replace_with_another_base64_secret
# JWT_ACCESS_TOKEN_TTL=PT1H
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# E-mail: MAIL_MODE=log writes verification codes to the console (dev only);
# MAIL_MODE=smtp sends real e-mail with the settings below.
# MAIL_MODE=log
# MAIL_FROM=no-reply@your-domain
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=your_smtp_user
# MAIL_PASSWORD=your_smtp_password

# Listing photos are stored in <UPLOAD_DIR>/products (default: uploads, git-ignored).
# UPLOAD_DIR=uploads

# V003 simulated shipping: key that signs the 15-minute quote tokens (required outside the dev profile).
# SHIPPING_QUOTE_SECRET=replace_with_base64_of_at_least_32_random_bytes
# Orders (Stage 4).
# Expiry job for the 24-hour confirmation / payment deadlines. OFF by default in the dev profile (protects the demo
# orders); ON by default in other profiles. Enable locally only on a database you may change.
# ORDER_EXPIRY_ENABLED=false
# ORDER_EXPIRY_INTERVAL=PT1M
# SANDBOX payment simulator (no real money). Never enable in production.
# PAYMENT_SIMULATOR_ENABLED=true
# PAYMENT_SIMULATOR_SECRET=replace_with_base64_of_at_least_32_random_bytes
