# ---------------------------------------------------------------------
# UniMarket backend - example environment configuration
# Copy this file to UniMarket-Backend/.env and fill in your own values:
#   Copy-Item .env.example .env
# UniMarket-Backend/.env is git-ignored. NEVER commit real credentials.
# Real environment variables take precedence over this file.
# ---------------------------------------------------------------------

# JDBC URL of the UniMarketJava database (created by UniMarket_BusinessAligned.sql).
# trustServerCertificate=true is for LOCAL development only.
# Default instance on port 1433:
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=UniMarketJava;encrypt=true;trustServerCertificate=true
# Named instance (needs the SQL Server Browser service), e.g.:
# DB_URL=jdbc:sqlserver://localhost;instanceName=SQLEXPRESS;databaseName=UniMarketJava;encrypt=true;trustServerCertificate=true

# SQL Server login (SQL Server Authentication must be enabled on the instance).
# Use a dedicated login with only the permissions the API needs, not 'sa'.
DB_USERNAME=your_sql_username
DB_PASSWORD=your_sql_password

# Optional overrides
# SERVER_PORT=8080
# DB_POOL_SIZE=10
# SPRING_PROFILES_ACTIVE=dev     # or 'nodb' to start without a database
