# ---------------------------------------------------------------------
# UniMarket backend - example environment configuration
# Copy this file to UniMarket-Backend/.env and fill in your own values:
#   Copy-Item .env.example .env
# UniMarket-Backend/.env is git-ignored. NEVER commit real credentials.
# ---------------------------------------------------------------------

# JDBC URL of the UniMarketDB database.
# trustServerCertificate=true is for LOCAL development only.
# Named instance example: jdbc:sqlserver://localhost\\SQLEXPRESS;databaseName=UniMarketDB;encrypt=true;trustServerCertificate=true
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=UniMarketDB;encrypt=true;trustServerCertificate=true

# SQL Server login (SQL Server Authentication)
DB_USERNAME=your_sql_username
DB_PASSWORD=your_sql_password

# Optional overrides
# SERVER_PORT=8080
# HIBERNATE_DDL_AUTO=validate
