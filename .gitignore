# =====================================================================
# UniMarket - Git ignore rules (Java/Spring Boot + React/Node.js)
# =====================================================================

# ---------- Java / Maven ----------
target/
*.class
*.jar
*.war
*.nar
*.ear
# Keep the Maven wrapper JAR if one is ever added (wrapper scripts are always tracked)
!.mvn/wrapper/maven-wrapper.jar
!**/.mvn/wrapper/maven-wrapper.jar
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties

# JVM crash logs (https://www.java.com/en/download/help/error_hotspot.xml)
hs_err_pid*
replay_pid*

# BlueJ / J2ME
*.ctxt
.mtj.tmp/

# ---------- Node.js / React / Vite ----------
node_modules/
dist/
dist-ssr/
.vite/
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- Environment files & local secrets ----------
.env
.env.local
.env.*.local
.env.development
.env.production
*.local
!.env.example
*.pem
*.key
*.p12
*.jks
*.pfx
secrets/
application-local.properties
application-local.yml

# ---------- IDEs / editors ----------
# VS Code: ignore personal settings but allow sharing recommended extensions
.vscode/*
!.vscode/extensions.json
.idea/
*.iml
*.iws
*.ipr
out/
.classpath
.project
.settings/
.factorypath
.apt_generated/
.sts4-cache/
.springBeans
nbproject/
nbbuild/
nbdist/
.nb-gradle/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------- Archives & build artifacts ----------
*.zip
*.tar.gz
*.rar
build/

# ---------- Logs & temporary files ----------
logs/
*.log
*.tmp
*.temp
*.bak
*.swp
*~

# ---------- OS files ----------
.DS_Store
Thumbs.db
desktop.ini

# Uploaded listing photos (local development storage). UPLOAD_DIR defaults to "uploads" relative to
# the working directory, so ignore it wherever the backend is started from.
UniMarket-Backend/uploads/
uploads/
